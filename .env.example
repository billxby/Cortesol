# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Generative LLM provider for the Research chat, grounded report generation, and
# import-a-field drafting. Set ONE key; Claude is the default. Precedence when
# several are set: Claude -> OpenAI -> Gemini. Force one with LLM_PROVIDER.
#   LLM_PROVIDER=anthropic|openai|gemini   (optional override)

# Claude (Anthropic) — the default provider. Official `anthropic` SDK.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI — an option. Standard OpenAI base URL.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Gemini — an option, via Google's OpenAI-compatible endpoint.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Freesolo Flash — serving endpoint is OpenAI-compatible.
FLASH_BASE_URL=https://api.freesolo.co/v1
FLASH_API_URL=https://flash.freesolo.co
FREESOLO_API_KEY=
FREESOLO_RUN_ID=

# -- optional for deployment/unused from here on out --
# Which adapter to serve. Swap between the stock base model and your tuned one
FLASH_MODEL_STOCK=Qwen/Qwen3.5-4B
FLASH_MODEL_TUNED=

# The SFT teacher (rejection sampling) and the "raw frontier LLM" eval baseline
# reuse the provider keys above (Claude by default). TEACHER_MODEL overrides the
# per-provider default teacher model (e.g. a stronger Claude or a specific GPT).
TEACHER_MODEL=

# Optional: Crossref / Retraction Watch polite pool email (screen.py retraction feed)
CROSSREF_MAILTO=
