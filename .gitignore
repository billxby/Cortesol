# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# uv
.uv/
uv.lock

# Env / secrets — NEVER commit Freesolo or OpenAI keys
.env
.env.local
.env.*
# teammate env files, e.g. env.teammate (holds live FLASH/FREESOLO keys)
env.*
*.key

# Test / tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Cortesol runtime artifacts (comments on their own lines — gitignore has no inline comments)
# KB JSON snapshots written after each event
snapshots/
# eval outputs, wandb-ish local logs
runs/
# generated SFT datasets (regenerable from the sim)
data/sft/*.jsonl
# generated GRPO episode seeds
data/episodes/
# generated event streams (regenerable: emit_stream(seed, n))
data/streams/
# demo foundation snapshot + holdout stream (regenerable: make bootstrap)
data/snapshots/
# demo recordings live in docs/media/ only when intentional
*.gif
!docs/media/*.gif

# OS / editor
.DS_Store
.idea/
.vscode/
