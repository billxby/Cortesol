# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# uv
.uv/
uv.lock

# Env / secrets — NEVER commit Freesolo or OpenAI keys
.env
.env.local
.env.*
# teammate env files, e.g. env.teammate (holds live FLASH/FREESOLO keys)
env.*
*.key

# Test / tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Cortesol runtime artifacts
runs/
snapshots/          # KB JSON snapshots written after each event
runs/               # eval outputs, wandb-ish local logs
data/sft/*.jsonl    # generated SFT datasets (regenerable from the sim)
data/episodes/      # generated GRPO episode seeds
data/streams/       # generated event streams (regenerable: emit_stream(seed, n))
*.gif               # demo recordings live in docs/media/ only when intentional
!docs/media/*.gif

# OS / editor
.DS_Store
.idea/
.vscode/
